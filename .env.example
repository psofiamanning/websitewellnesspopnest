# Stripe Configuration
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Backend URL (en producción usar la URL de tu API, ej. https://api.popnest.app)
VITE_BACKEND_URL=http://localhost:3002

# Supabase (Auth + reset de contraseña en el navegador). Misma URL que en el proyecto; anon key es la pública.
# VITE_SUPABASE_URL=https://cgtiuulyregyxdpaudtf.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Meta (Facebook) Pixel ID para envío de leads a Meta Ads
# Obtén tu Pixel ID en: Meta Business Suite > Configuración de datos > Pixeles
VITE_META_PIXEL_ID=
