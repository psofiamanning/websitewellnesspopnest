# Stripe Secret Key (obténla en https://dashboard.stripe.com/apikeys)
# IMPORTANTE: Esta clave NUNCA debe estar en el frontend
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret (opcional, para producción)
# Se obtiene al configurar webhooks en Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email: MailerSend (recomendado, mismo ecosistema que MailerLite) o Gmail SMTP
# Opción A - MailerSend (recomendado para producción; evita timeouts en Railway)
# Crear cuenta en https://www.mailersend.com (puedes usar SSO con MailerLite)
# API Key en MailerSend: Domains → API Tokens. El "from" debe ser un email de dominio verificado.
MAILERSEND_API_KEY=mlsn.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILERSEND_FROM_EMAIL=info@estudiopopnest.com
MAILERSEND_FROM_NAME=Estudio Popnest Wellness

# Opción B - Gmail SMTP (si no usas MailerSend)
# Crear App Password en https://myaccount.google.com/apppasswords
SMTP_MAIL_USER=tu-correo@estudiopopnest.com
SMTP_MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# URL del frontend (para el enlace de restablecer contraseña en el correo)
# En producción: https://popnest.app
FRONTEND_URL=http://localhost:5173

# Puerto del servidor
PORT=3000

# Recuperar contraseña de administrador sin correo (opcional)
# Si el correo no llega, puedes restablecer con: POST /api/auth/admin/force-reset-password
# Body: { "email": "tu@correo.com", "newPassword": "nuevaContraseña", "secret": "el mismo valor de abajo" }
# ADMIN_RESET_SECRET=una_clave_secreta_larga_y_dificil

# Clave para acceder a imágenes de marketing (opcional)
# Endpoint: /api/marketing/image/:name?key=EL_MISMO_VALOR_DE_ABAJO
# Ejemplo en producción:
#   https://api.popnest.app/api/marketing/image/banner-newsletter.png?key=EL_MISMO_VALOR_DE_MARKETING_ASSETS_KEY
# MARKETING_ASSETS_KEY=otra_clave_secreta_larga

# Códigos de descuento (clase gratis, un uso por correo). Opcional; si no se define, se usan BIENVENIDA y POPNEST.
# Formato: CODIGO:Etiqueta visible,CODIGO2:Otra etiqueta
# DISCOUNT_CODES=BIENVENIDA:Clase de bienvenida,POPNEST:Promoción especial

# Supabase: reservas y usuarios persistentes (solo estas dos variables son necesarias)
# Proyecto: Wellness Database · Project ID: cgtiuulyregyxdpaudtf
# Obtener en https://supabase.com → tu proyecto → Settings → API: Project URL y service_role (secret)
# SUPABASE_URL=https://cgtiuulyregyxdpaudtf.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clave anon (pública) — misma que VITE_SUPABASE_ANON_KEY; necesaria para login/registro desde el backend
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
